# World of Shelves — Root .htaccess
# Sprint 0: Security & Performance Hardening

# ───────────────────────────────────────────────
# 1. Disable Directory Listing
# ───────────────────────────────────────────────
Options -Indexes -MultiViews

# ───────────────────────────────────────────────
# 2. Block Direct Access to Sensitive Files
# ───────────────────────────────────────────────
<FilesMatch "\.(db|sqlite|sql|env|log|ini|sh|bak|old)$">
    Require all denied
</FilesMatch>

# Block access to hidden files (.git, .env, etc.)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Block direct HTTP access to administrative, migration, diagnostic, generator scripts, and internal sitemap data
<FilesMatch "^(generate-sitemap\.php|sitemap-data\.xml|verify_.*\.php|run_.*\.php|diag_.*\.php|find_.*\.php|scan_.*\.php|sync_production_sitemap\.php)$">
    Require all denied
</FilesMatch>

# ───────────────────────────────────────────────
# 3. Gzip Compression (reduces CSS/JS transfer by 60–70%)
# ───────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ───────────────────────────────────────────────
# 4. Browser Cache Headers (reduces repeat-visit load time)
# ───────────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault                          "access plus 1 month"
    ExpiresByType image/jpg                 "access plus 1 year"
    ExpiresByType image/jpeg                "access plus 1 year"
    ExpiresByType image/gif                 "access plus 1 year"
    ExpiresByType image/png                 "access plus 1 year"
    ExpiresByType image/webp                "access plus 1 year"
    ExpiresByType image/svg+xml             "access plus 1 year"
    ExpiresByType image/x-icon              "access plus 1 year"
    ExpiresByType text/css                  "access plus 1 month"
    ExpiresByType application/javascript    "access plus 1 month"
    ExpiresByType text/javascript           "access plus 1 month"
</IfModule>

# Disable caching for sitemap.xml to ensure LiteSpeed and proxies serve real-time sitemap
<FilesMatch "sitemap\.xml$">
    <IfModule mod_expires.c>
        ExpiresActive Off
    </IfModule>
    <IfModule mod_headers.c>
        Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "Wed, 11 Jan 1984 05:00:00 GMT"
    </IfModule>
</FilesMatch>

# ───────────────────────────────────────────────
# 5. Additional Security Headers
# ───────────────────────────────────────────────
<IfModule mod_headers.c>
    # Remove PHP version disclosure (other security headers are handled by PHP in config/init.php)
    Header unset X-Powered-By
    Header always unset X-Powered-By
</IfModule>

# ───────────────────────────────────────────────
# 6. Prevent PHP Version Disclosure
# ───────────────────────────────────────────────
ServerSignature Off

# ───────────────────────────────────────────────
# 7. Custom Error Pages (prevent default Apache error leakage)
# ───────────────────────────────────────────────
ErrorDocument 404 /404

# ───────────────────────────────────────────────
# 8. SEO-Friendly Extensionless URLs & Admin Routing
# ───────────────────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Dynamic Sitemap Handler: Route sitemap.xml to sitemap.php immediately after RewriteEngine On
    RewriteRule ^sitemap\.xml$ sitemap.php [L,NC]

    # Clean Category and Product Detail URLs Rewrite Rules
    RewriteRule ^products/category/([a-zA-Z0-9_-]+)$ products.php?category_slug=$1 [QSA,L]
    RewriteRule ^products/([a-zA-Z0-9_-]+)$ product-details.php?slug=$1 [QSA,L]
    RewriteRule ^projects/category/([a-zA-Z0-9_-]+)$ projects.php?category_slug=$1 [QSA,L]

    # 0. Host Normalization: www.worldofshelves.com -> worldofshelves.com (Direct 301)
    RewriteCond %{HTTP_HOST} ^www\.worldofshelves\.com$ [NC]
    RewriteRule ^(.*)$ https://worldofshelves.com/$1 [R=301,L]

    # 1. Homepage Normalization: index.php -> / (GET/HEAD only, excludes /admin/)
    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$ [NC]
    RewriteCond %{THE_REQUEST} !/admin/ [NC]
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^?#\s]*)index\.php [NC]
    RewriteRule ^index\.php$ /%1 [R=301,L]

    # 2. Homepage Normalization: index -> / (GET/HEAD only, excludes /admin/)
    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$ [NC]
    RewriteCond %{THE_REQUEST} !/admin/ [NC]
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^?#\s]*)index[\s\?] [NC]
    RewriteRule ^index$ /%1 [R=301,L]

    # 3. Redirect public /page.php to /page (GET/HEAD only, excludes /admin/, preserves query parameters)
    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$ [NC]
    RewriteCond %{THE_REQUEST} !/admin/ [NC]
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(?:[^?#\s]*/)?(about|products|product-details|services|projects|project-details|used-shelves|installation|contact)\.php[\s\?] [NC]
    RewriteRule ^(about|products|product-details|services|projects|project-details|used-shelves|installation|contact)\.php$ $1 [R=301,L]

    # 4. Public Internal Rewrite: /page -> /page.php (serves page transparently, supports POST/GET)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^(about|products|product-details|services|projects|project-details|used-shelves|installation|contact)$ $1.php [QSA,L]

    # 5. Admin Internal Rewrite: /admin/page -> /admin/page.php (serves admin page transparently if page.php exists, no 301 redirect)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^admin/([a-z0-9_-]+)$ admin/$1.php [QSA,L]
</IfModule>

